{
	"name": "ubuntu",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"test": "vitest run",
		"check:bundle": "node scripts/check-bundle-size.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.mjs",
		"start": "next start",
		"lint": "next lint",
		"cf": "node --env-file-if-exists=.env.local node_modules/@opennextjs/cloudflare/dist/cli/index.js",
		"deploy": "pnpm cf build && pnpm cf deploy",
		"upload": "pnpm cf build && pnpm cf upload",
		"preview": "pnpm cf build && pnpm cf preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.9",
		"drizzle-orm": "^0.45.2",
		"next": "16.2.11",
		"postgres": "^3.4.9",
		"react": "^19.1.7",
		"react-dom": "^19.1.7"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.11",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vitest": "^4.1.10",
		"wrangler": "^4.86.0"
	}
}